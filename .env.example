KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
WEATHER_API_KEY=
# Local LLM only: http://127.0.0.1:11434, qwen3.5:9b (fixed in code).
# No OpenAI key or cloud fallback. First model load may take longer.
WHERE_FOOD_OLLAMA_TIMEOUT_SECONDS=120
# Optional RAG explanation timeout (1..60 seconds); failure keeps template cards.
WHERE_FOOD_RAG_TIMEOUT_SECONDS=30
# OLLAMA_NO_CLOUD=1 must be set on the Ollama SERVER, not just this Flask .env.
# Stable session/draft signing key. Restarting without it invalidates 30-minute drafts.
FLASK_SECRET_KEY=
# LangGraph runs locally with tracing disabled; no LangSmith/API key needed.
# Optional: defaults to instance/where_food.db in the project directory.
# DATABASE_PATH=instance/where_food.db
# Set to 1 when serving through HTTPS.
COOKIE_SECURE=0
